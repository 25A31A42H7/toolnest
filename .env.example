# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: Your production domain used for canonical URLs, Open Graph tags,
# sitemap.xml, and robots.txt during static prerendering (no trailing slash).
# Leave empty until your production domain is ready so dev/staging URLs are not indexed.
# Example: VITE_SITE_URL="https://yourdomain.com"
VITE_SITE_URL=""

# VITE_BASE_PATH: Optional asset/router base path (defaults to "/", or auto-detected in GitHub Actions).
# Set only when deploying to a subpath without VITE_SITE_URL (e.g., "/repo-name/").
VITE_BASE_PATH="/"

# VITE_CONTACT_FORM_ENDPOINT: Optional HTTPS form endpoint (e.g., Formspree public form URL)
# for live contact form delivery on static hosting such as GitHub Pages.
# Example: VITE_CONTACT_FORM_ENDPOINT="https://formspree.io/f/your_form_id"
VITE_CONTACT_FORM_ENDPOINT=""

# VITE_CONTACT_EMAIL: Optional public support email shown on the Contact and Privacy pages.
VITE_CONTACT_EMAIL=""
